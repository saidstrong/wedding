NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Both route-specific passcodes are required and must be different.
# The legacy ADMIN_PASSCODE variable is no longer used.
ADMIN_PASSCODE_BEKSULTAN_BULBUL=replace-with-a-long-beksultan-admin-passcode
ADMIN_PASSCODE_SHYNGYS_NAZERKE=replace-with-a-long-shyngys-admin-passcode
